   "id": "q_94be37b8891d4a29ac7e42d3e27e9f18",
   "type": "ASSERTION_REASON",
   "unit": "General Mental Ability, Numerical Ability,",
   "stem": "Assertion (A): If the price of an item rises by 25%, it must fall by 20% to return to the original price.\nReason (R): The percentage fall is calculated on the new price, which is 125% of the original, so the fall is 25 / 125 x 100 = 20%.",
   "structure": null,
   "passage": null,
   "options": [
    {
     "position": 1,
     "label": "A",
     "text": "Both (A) and (R) are true and (R) is the correct explanation of (A)."
    },
    {
     "position": 2,
     "label": "B",
     "text": "Both (A) and (R) are true but (R) is not the correct explanation of (A)."
    },
    {
     "position": 3,
     "label": "C",
     "text": "(A) is true but (R) is false."
    },
    {
     "position": 4,
     "label": "D",
     "text": "(A) is false but (R) is true."
    }
   ]
  },

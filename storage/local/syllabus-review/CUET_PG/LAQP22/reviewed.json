  {"ref": "cn_5a498630c12f4e5bbde575411da92df4", "parentRef": "cn_35212b64b9ab4cf08297eea612fcc679", "kind": "ITEM", "label": "iv", "title": "The Question paper will be in Limbu.", "body": null, "sourcePage": 2},
  {"ref": "cn_3403910008fd4bc8878e0fd62ee54a4f", "parentRef": null, "kind": "TOPIC", "label": "1", "title": "ᤕᤠᤠᤰᤌᤢᤱ ᤐᤠᤏ᤻ᤗᤧᤧᤴ ᤛᤠᤠᤵᤔᤧᤴᤎᤢᤶᤛᤡᤃᤠᤢᤱ ᤁᤧᤎᤠᤒᤠ ᤕᤧᤧᤴᤏᤡᤋ᤻. ᤋᤢᤱᤒᤣ ᤏᤢ ᤕᤧᤁ᤻ᤐᤠ ᤜᤡᤧᤴᤎᤠᤣᤁ᤻ᤜᤠᤠ᤹ ᤘᤃᤧᤖᤠ ॥", "body": null, "sourcePage": 2},
  {"ref": "cn_4125ce25b91f4e81bd3314424e820a2b", "parentRef": null, "kind": "TOPIC", "label": "2", "title": "ᤕᤠᤠᤰᤌᤢᤱ ᤛᤠᤠᤵᤐᤠᤏ᤻ᤏᤡᤒᤠ ᤛᤢᤳᤗᤠᤜᤠᤠ᤹ᤖᤧᤧᤴ ᤛᤠᤰᤏᤡᤔ᤻:", "body": "ᤛᤠᤠᤵᤛᤠᤰ ᤛᤘᤠ. ᤕᤠᤢᤱᤏᤡᤔ᤻ᤘᤠ. ᤋᤠᤠ᤹ᤈᤧᤢᤱᤃᤡ. ᤐᤠᤋ᤻ᤋᤡᤗᤠ. ᤛᤠᤢᤶᤔᤡᤗᤠ. ᤋᤧᤧᤴ. ᤕᤧᤢᤶ. ᤜᤡᤧᤴᤎᤠᤣᤁ᤻. ᤛᤢᤳᤗᤠ. ᤐᤧᤧᤴᤇᤡᤢᤱ. ᤀᤡᤗᤠ. ᤛᤠᤢᤶᤗᤠᤣ. ᤔᤣᤖᤡᤢᤱ. ᤁᤧᤛᤖᤢᤱ. ᤛᤠᤠᤵᤐᤠᤏ᤻ ᤛᤠᤠᤵᤐᤣ. ᤔᤠᤰᤐᤠᤏ᤻. ᤐᤠᤢᤱᤂᤧᤍᤠᤠ᤹. ᤛᤠᤠᤵᤆᤠᤣ. ᤀᤣᤋ᤻ᤗᤠᤒᤠ. ᤋᤠᤰᤂᤣᤘᤠᤒᤠ. ᤜᤧᤧᤴᤇᤠᤠᤵᤐᤠ. ᤛᤠᤢᤶᤒᤠ. ᤀᤡᤒᤠ. ᤆᤠᤣᤔᤡᤠᤰ. ᤏᤠᤀᤡᤒᤣᤁ᤻. ᤂᤧᤍᤠᤠ᤹ᤒᤢᤱ. ᤁᤢᤈᤢᤶ. ᤁᤢᤏᤢᤢᤶ. ᤂᤧᤀᤡᤔ᤻ᤒᤣ. ᤛᤠᤰᤏᤡᤔ᤻. ᤜᤧᤧᤴᤈᤡᤗᤠ. ᤜᤁ᤻ᤘᤠ. ᤏᤢᤠᤵᤗᤠᤈᤢᤱ. ᤔᤠᤰᤛᤡ ᤘᤃᤧᤖᤠ ॥", "sourcePage": 2},
  {"ref": "cn_3666c3c7fcdf4e88a0b64443d9b9bf97", "parentRef": null, "kind": "TOPIC", "label": "3", "title": "ᤕᤠᤠᤰᤌᤢᤱ ᤜᤠᤵᤐᤠᤏ᤻ ᤏᤢ ᤛᤠᤠᤵᤐᤠᤏ᤻ ᤛᤠᤠᤵᤆᤠᤗᤠᤢᤶ:", "body": "ᤋᤠᤰᤋᤢᤶ ᤛᤠᤰ. ᤀᤣᤁ᤻ᤋᤢᤶ ᤛᤠᤰ. ᤔᤡᤢᤱ. ᤔᤡᤢᤱᤗᤧᤠᤰ. ᤐᤠᤢᤶᤔᤣ. ᤐᤠᤢᤶᤔᤣᤐᤠᤣ. ᤛᤢᤳᤗᤠ. ᤐᤧᤧᤴᤇᤡᤢᤱ. ᤀᤡᤠᤰᤗᤧᤢᤱᤗᤧᤧᤴ ᤁᤢᤃᤠᤣ. ᤑᤠᤵᤐᤧᤧᤴᤇᤡᤢᤱ. ᤆᤠᤰ ᤐᤧᤧᤴᤇᤡᤢᤱ. ᤛᤖᤠ᤹ᤒᤠ ᤐᤧᤧᤴᤇᤡᤢᤱ. ᤛᤠᤰᤛᤠᤖᤧᤧᤴ ᤀᤡᤠᤰᤗᤧᤢᤱᤍᤧᤧᤴ. ᤕᤠᤠᤰᤌᤢᤱ ᤐᤠᤏ᤻ ᤏᤢ ᤛᤠᤠᤵᤐᤠᤏ᤻. ᤆᤢ. ᤕᤧᤢᤶ. ᤐᤠᤠᤸᤗᤠ. ᤐᤢᤱ ᤛᤢᤳᤗᤠ. ᤌᤡᤠᤰ ᤐᤣᤕᤠᤰ ᤛᤢᤳᤗᤠ. ᤀᤣᤁ᤻ᤐᤣᤕᤠᤰ ᤛᤢᤳᤗᤠ. ᤗᤠᤣᤛᤠᤣᤁ᤻. ᤔᤠᤰᤐᤠᤏ᤻. ᤐᤠᤏ᤻ᤗᤠᤵ. ᤋᤠᤰᤐᤣ. ᤁᤧᤍᤢᤶᤒᤠ ᤛᤠᤰᤛᤠ. ᤀᤣᤁ᤻ᤋᤢᤶ ᤛᤠᤰᤛᤠ. ᤁᤢᤛᤣᤁ᤻ ᤛᤠᤰ. ᤛᤠᤰᤏᤠᤢᤶ. ᤔᤧᤧᤴᤍᤡᤢᤱ. ᤋᤧᤧᤴᤍᤡᤢᤱ, ‘ᤗᤧ’ ᤏᤢ ‘ᤖᤧ’ ᤜᤧᤠᤰᤁᤣᤀᤠᤢᤱ ‘ᤗᤧᤧᤴ’ ᤏᤢ ‘ᤖᤧᤧᤴ’ ᤜᤠᤠ᤹ᤖᤧᤧᤴ ᤀᤠᤣᤃᤠᤠᤵ ᤘᤠᤃᤧᤖᤠ ॥", "sourcePage": 2},
  {"ref": "cn_9f298a1402324d83a85cdcf2d16ca738", "parentRef": null, "kind": "TOPIC", "label": "4", "title": "ᤕᤠᤠᤰᤌᤢᤱ ᤛᤠᤠᤵᤛᤠᤰᤗᤧᤧᤴ ᤜᤧᤧᤴᤗᤠᤜᤠᤠ᤹ᤗᤠᤢᤶ:", "body": "ᤛᤠᤢᤶᤔᤡᤗᤠᤛᤡᤃᤠᤢᤱ ᤁᤧᤎᤠᤒᤠ ᤗᤠᤰ ᤛᤠᤔ᤻ᤒᤣ. ᤔᤠ ᤛᤠᤔ᤻ᤒᤣ. ᤋᤠᤢᤱᤒᤠ ᤛᤠᤢᤶᤔᤡᤗᤠ. ᤐᤠᤢᤱ ᤛᤠᤢᤶᤔᤡᤗᤠ ᤘᤃᤧᤖᤠ. ᤂᤧᤍᤠᤠ᤹. ᤐᤠᤢᤱᤕᤢᤔᤧᤢᤳ. ᤐᤠᤢᤱᤘᤠᤀᤡᤗᤠ. ᤏᤡᤛᤠᤔ᤻ᤒᤣ. ᤛᤠᤢᤶᤈᤡᤠᤰ ᤔᤧᤴᤎᤢᤶ. ᤛᤢᤶ ᤘᤠᤃᤧᤖᤠᤖᤧᤧᤴ ᤀᤡᤢᤱᤈᤢᤶ. ᤜᤧᤧᤴᤈᤡᤗᤠ ᤐᤖᤡᤠᤰ ᤏᤢ ᤔᤠᤰᤛᤡᤜᤠᤠ᤹ᤖᤧᤧᤴ ᤜᤧᤠᤰᤁᤣᤀᤠᤢᤱ ᤛᤠᤠᤵᤛᤠᤰ ᤜᤧᤧᤴᤗᤠᤜᤠᤠ᤹ᤖᤧᤧᤴ ᤛᤠᤰᤏᤡᤔ᤻ ॥", "sourcePage": 2},
  {"ref": "cn_2b0c1a67eeb04862a90b8c3596138c81", "parentRef": null, "kind": "TOPIC", "label": "5", "title": "ᤛᤠᤠᤵᤛᤠᤰᤁᤡᤒᤠ ᤕᤠᤠᤵᤔᤡᤜᤠᤠ᤹ᤖᤧᤧᤴ ᤔᤡᤢᤱ. ᤛᤠᤠᤵᤛᤠᤰᤁᤡᤒᤠ ᤕᤠᤔ᤻ᤒᤠᤰ. ᤌᤢᤶᤄᤠᤣ. ᤛᤠᤠᤵᤐᤧᤴ ᤘᤠᤃᤧᤖᤠ ॥", "body": null, "sourcePage": 2},
  {"ref": "cn_b5799a889e1e45828c1b4d332d89fbf9", "parentRef": null, "kind": "TOPIC", "label": "6", "title": "ᤁᤠᤣᤔ᤻ᤓᤠᤣ ᤌᤡᤢᤶᤛᤣᤏ᤻ᤎᤠᤰᤗᤠᤢᤶ:", "body": "ᤛᤠᤠᤵᤛᤠᤰ ᤜᤢᤱᤛᤠᤠ᤹. ᤁᤠᤣᤔ᤻ᤓᤠᤣᤖᤧᤧᤴ ᤁᤢᤒᤣ. ᤁᤠᤣᤔ᤻ᤓᤠᤣᤖᤧᤧᤴ ᤛᤢᤶᤒᤠᤣ. ᤁᤠᤣᤔ᤻ᤓᤠᤣ ᤆᤧᤕᤠᤔ᤻ᤓᤠᤣ. ᤏᤠᤔ᤻ᤓᤣᤘᤠ ᤑᤢᤱᤔᤠ. ᤐᤛᤣᤁ᤻ᤘᤠᤒᤠ ᤛᤠᤠᤵᤐᤧᤴ. ᤛᤠᤠᤵᤛᤠᤰ ᤂᤢᤔ᤻ᤔᤠ. ᤕᤧᤁ᤻ᤛᤠᤠᤵ ᤛᤠᤠᤵᤐᤣ. ᤛᤠᤠᤵᤐᤧᤴ ᤐᤠᤣᤜᤡ. ᤁᤠᤣᤔ᤻ᤓᤠᤣᤖᤧᤧᤴ ᤐᤖᤡᤠᤰ. ᤀᤡᤢᤱᤈᤢᤶ ᤘᤃᤧᤖᤠ ॥", "sourcePage": 2}
 ],
